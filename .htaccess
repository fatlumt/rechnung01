Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteCond %{HTTP_HOST} ^digital\.krasniqi-plattenleger\.ch$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://digital.krasniqi-plattenleger.ch%{REQUEST_URI} [R=302,L]
RewriteRule ^(?:backend|frontend|tools|tests|private|public|node_modules|vendor|work|outputs)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
<FilesMatch "(?i)(?:\.(?:sql|md|json|lock|log|ini|bak|backup|old|orig|save|swp|zip|tar|gz|ya?ml|map|env|pem|key|ts|tsx|py|ps1|sh)$|~$|^config\.)">
Require all denied
</FilesMatch>

AddType application/javascript .mjs
AddType application/manifest+json .webmanifest
